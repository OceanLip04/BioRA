{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BioRA Daily Research Digest v1",
  "$comment": "Additional scientific graph, source-page, language, monotonic revision and 2,000,000-byte validations are specified in BIORA_DAILY_RESEARCH_API.md. This schema does not validate scientific truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "date", "timezone", "language", "feed", "revision", "title", "summary", "published_at", "sources", "citations", "graph"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timezone": {"type": "string", "minLength": 1},
    "language": {"enum": ["zh-Hans", "en"]},
    "feed": {"$ref": "#/$defs/identifier"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "summary": {"type": "string", "maxLength": 10000},
    "published_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "sources": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/source"}},
    "citations": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/citation"}},
    "graph": {"$ref": "#/$defs/graph"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "nodeKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"},
    "page": {"type": ["integer", "null"], "minimum": 1, "maximum": 500},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "page_count"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
        "page_count": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["node_key", "source_id", "page"],
      "properties": {
        "node_key": {"$ref": "#/$defs/nodeKey"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "page": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind", "text", "source_page"],
      "properties": {
        "key": {"$ref": "#/$defs/nodeKey"},
        "kind": {"enum": ["assertion", "hypothesis", "observation", "conclusion"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "source_page": {"$ref": "#/$defs/page"}
      }
    },
    "atom": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "title", "method", "status", "observed_result", "source_page"],
      "properties": {
        "key": {"$ref": "#/$defs/nodeKey"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "method": {"type": "string", "maxLength": 10000},
        "status": {"enum": ["recorded", "planned"]},
        "observed_result": {"type": "string", "maxLength": 20000},
        "source_page": {"$ref": "#/$defs/page"}
      }
    },
    "evidenceLink": {
      "type": "object", "additionalProperties": false,
      "required": ["atom_key", "claim_key", "kind", "explanation", "limitations"],
      "properties": {
        "atom_key": {"$ref": "#/$defs/nodeKey"},
        "claim_key": {"$ref": "#/$defs/nodeKey"},
        "kind": {"enum": ["supports", "contradicts"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 10000},
        "limitations": {"type": "string", "maxLength": 10000}
      }
    },
    "claimLink": {
      "type": "object", "additionalProperties": false,
      "required": ["from_key", "to_key", "kind", "explanation", "limitations"],
      "properties": {
        "from_key": {"$ref": "#/$defs/nodeKey"},
        "to_key": {"$ref": "#/$defs/nodeKey"},
        "kind": {"enum": ["supports", "contradicts"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 10000},
        "limitations": {"type": "string", "maxLength": 10000}
      }
    },
    "mainlineStep": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_key", "question", "motivation", "origin", "role"],
      "properties": {
        "claim_key": {"$ref": "#/$defs/nodeKey"},
        "question": {"type": "string", "minLength": 1, "maxLength": 3000},
        "motivation": {"type": "string", "minLength": 1, "maxLength": 5000},
        "origin": {"enum": ["reported", "inferred"]},
        "role": {"enum": ["result", "discussion"]}
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "detail", "claims", "atomic_experiments", "evidence_links", "claim_links", "mainline"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "detail": {"type": "string", "maxLength": 20000},
        "claims": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"$ref": "#/$defs/claim"}},
        "atomic_experiments": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/atom"}},
        "evidence_links": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/evidenceLink"}},
        "claim_links": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/claimLink"}},
        "mainline": {
          "type": "array", "minItems": 2, "maxItems": 60, "items": {"$ref": "#/$defs/mainlineStep"},
          "contains": {"properties": {"role": {"const": "discussion"}}, "required": ["role"]},
          "minContains": 1, "maxContains": 1
        }
      }
    }
  }
}
